# MongoDB connection string (Atlas or local)
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/surplus?retryWrites=true&w=majority"

# Google OAuth (optional — leave empty to use email OTP instead)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# SMTP email OTP (used when Google OAuth is not configured)
SMTP_SERVICE="gmail"
SMTP_MAIL=""
SMTP_PASSWORD=""
SMTP_PORT=465
SMTP_HOST="smtp.gmail.com"

# JWT secret — generate a random string for production
JWT_SECRET="change-me-to-a-long-random-string"

# Frontend URL (for CORS and OAuth redirect)
# Use http://localhost:5000 when serving the built frontend from backend (frontend/dist)
# Use http://localhost:5173 when running the Vite dev server separately
FRONTEND_URL="http://localhost:5000"

# Server port
PORT=5000

# Gemini AI for product image analysis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Local product image uploads
UPLOAD_DIR="uploads/products"
MAX_PRODUCT_IMAGES=5
