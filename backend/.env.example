# MongoDB connection string (Atlas or local)
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/surplus?retryWrites=true&w=majority"

# Google OAuth (optional — leave empty to use email OTP instead)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# SMTP email OTP (used when Google OAuth is not configured)
SMTP_SERVICE="gmail"
SMTP_MAIL=""
SMTP_PASSWORD=""
SMTP_PORT=465
SMTP_HOST="smtp.gmail.com"

# JWT secret — generate a random string for production
JWT_SECRET="change-me-to-a-long-random-string"

# Firebase Admin (mobile phone OTP). Use a service account from Firebase Console.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Frontend URL (for CORS and OAuth redirect)
# Use http://localhost:5000 when serving the built frontend from backend (frontend/dist)
# Use http://localhost:5173 when running the Vite dev server separately
FRONTEND_URL="http://localhost:5000"

# Server port
PORT=5000

# Gemini AI for product image analysis
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# AWS S3 product image storage
# S3 layout: products/{category}/{subCategory}/{productId}/01-....jpg
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional: CloudFront or custom CDN base (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=""

# Optional prefix root (default: products)
# AWS_S3_PREFIX="products"

# Presigned URL lifetime in seconds for app image loading (default: 604800 = 7 days)
# AWS_S3_PRESIGN_EXPIRES_SECONDS=604800

MAX_PRODUCT_IMAGES=5

# Product image optimization before S3 / AI analyze
IMAGE_MAX_DIMENSION=1200
IMAGE_WEBP_QUALITY=80
IMAGE_TARGET_SIZE_KB=100
