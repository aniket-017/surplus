generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
}

enum PriceType {
  FIXED
  NEGOTIABLE
  PER_KG
  PER_UNIT
  PER_LOT
}

enum ProductCondition {
  NEW
  USED
  SURPLUS
  REFURBISHED
}

enum ListingStatus {
  ACTIVE
  SOLD
  DELETED
}

enum ReportReason {
  SPAM
  MISLEADING
  PROHIBITED
  WRONG_CATEGORY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum NotificationAudience {
  ALL
  BUYERS
  SELLERS
  SPECIFIC
}

type ProductAttribute {
  key   String
  value String
}

type ProductLocation {
  address String?
  city    String
  state   String
  pincode String
}

type UserAddress {
  address String?
  city    String
  state   String
  pincode String
  latitude Float?
  longitude Float?
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  googleId    String?   @map("google_id")
  email       String?
  phone       String?
  firebaseUid String?   @map("firebase_uid")
  name        String?
  avatarUrl   String?   @map("avatar_url")
  role        UserRole?
  address     UserAddress?
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  deletedReason String? @map("deleted_reason")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isBanned     Boolean   @default(false) @map("is_banned")
  bannedAt     DateTime? @map("banned_at")
  bannedReason String?   @map("banned_reason")
  referralCodeId     String?   @map("referral_code_id") @db.ObjectId
  referralCode       ReferralCode? @relation(fields: [referralCodeId], references: [id])
  referralAppliedAt  DateTime? @map("referral_applied_at")
  products  Product[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]
  savedListings       SavedListing[]
  reportsFiled        ListingReport[]
  pushTokens          PushToken[]
  notificationsCreated Notification[] @relation("NotificationsCreated")
  userNotifications   UserNotification[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@index([firebaseUid])
  @@index([googleId])
  @@index([isDeleted])
  @@index([isSuperAdmin])
  @@index([referralCodeId])
  @@map("users")
}

model ReferralCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  label     String?
  isActive  Boolean  @default(true) @map("is_active")
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referral_codes")
}

model PushToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_tokens")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otps")
}

model Product {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  sellerId     String             @map("seller_id") @db.ObjectId
  seller       User               @relation(fields: [sellerId], references: [id])

  title        String
  category     String
  subCategory  String             @map("sub_category")
  description  String

  quantity     Float
  quantityUnit String             @map("quantity_unit")

  price        Float
  priceType    PriceType          @map("price_type")
  condition    ProductCondition
  listingStatus ListingStatus     @default(ACTIVE) @map("listing_status")

  images       String[]

  viewCount    Int                @default(0) @map("view_count")

  attributes   ProductAttribute[]
  location     ProductLocation

  conversations Conversation[]
  savedBy       SavedListing[]
  reports       ListingReport[]

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([category, subCategory])
  @@index([listingStatus])
  @@map("products")
}

model Conversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  buyerId         String    @map("buyer_id") @db.ObjectId
  sellerId        String    @map("seller_id") @db.ObjectId
  productId       String    @map("product_id") @db.ObjectId
  buyer           User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller          User      @relation("SellerConversations", fields: [sellerId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  messages             Message[]
  buyerLastReadAt      DateTime? @map("buyer_last_read_at")
  sellerLastReadAt     DateTime? @map("seller_last_read_at")
  buyerLastDeliveredAt DateTime? @map("buyer_last_delivered_at")
  sellerLastDeliveredAt DateTime? @map("seller_last_delivered_at")
  buyerUnreadCount     Int       @default(0) @map("buyer_unread_count")
  sellerUnreadCount    Int       @default(0) @map("seller_unread_count")
  lastMessageAt        DateTime  @default(now()) @map("last_message_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @map("conversation_id") @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  imageUrl       String?      @map("image_url")
  fileUrl        String?      @map("file_url")
  fileName       String?      @map("file_name")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model SavedListing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  productId String   @map("product_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("saved_listings")
}

model ListingReport {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  reporterId String       @map("reporter_id") @db.ObjectId
  productId  String       @map("product_id") @db.ObjectId
  reporter   User         @relation(fields: [reporterId], references: [id])
  product    Product      @relation(fields: [productId], references: [id])
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([reporterId, productId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("listing_reports")
}

model CategoryMeta {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("category_meta")
}

model Notification {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  body           String
  audience       NotificationAudience
  targetUserIds  String[]             @default([]) @map("target_user_ids") @db.ObjectId
  createdById    String               @map("created_by_id") @db.ObjectId
  createdBy      User                 @relation("NotificationsCreated", fields: [createdById], references: [id])
  recipientCount Int                  @default(0) @map("recipient_count")
  receipts       UserNotification[]
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([createdById])
  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String       @map("notification_id") @db.ObjectId
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([notificationId, userId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notifications")
}
