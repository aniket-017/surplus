generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
}

enum PriceType {
  FIXED
  NEGOTIABLE
  PER_KG
  PER_UNIT
  PER_LOT
}

enum ProductCondition {
  NEW
  USED
  SCRAP
  REFURBISHED
}

type ProductAttribute {
  key   String
  value String
}

type ProductLocation {
  address String?
  city    String
  state   String
  pincode String
}

type UserAddress {
  address String?
  city    String
  state   String
  pincode String
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  googleId  String?   @map("google_id")
  email     String    @unique
  name      String?
  avatarUrl String?   @map("avatar_url")
  role      UserRole?
  address   UserAddress?
  products  Product[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]
  savedListings       SavedListing[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([googleId])
  @@map("users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otps")
}

model Product {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  sellerId     String             @map("seller_id") @db.ObjectId
  seller       User               @relation(fields: [sellerId], references: [id])

  title        String
  category     String
  subCategory  String             @map("sub_category")
  description  String

  quantity     Float
  quantityUnit String             @map("quantity_unit")

  price        Float
  priceType    PriceType          @map("price_type")
  condition    ProductCondition

  images       String[]

  viewCount    Int                @default(0) @map("view_count")

  attributes   ProductAttribute[]
  location     ProductLocation

  conversations Conversation[]
  savedBy       SavedListing[]

  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([category, subCategory])
  @@map("products")
}

model Conversation {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  buyerId       String    @map("buyer_id") @db.ObjectId
  sellerId      String    @map("seller_id") @db.ObjectId
  productId     String    @map("product_id") @db.ObjectId
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  messages      Message[]
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @map("conversation_id") @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  imageUrl       String?      @map("image_url")
  fileUrl        String?      @map("file_url")
  fileName       String?      @map("file_name")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model SavedListing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  productId String   @map("product_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("saved_listings")
}

model CategoryMeta {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("category_meta")
}
