# Copy to mobile/.env for local development (mobile/.env is gitignored).
# Use your computer's LAN IP so a physical device can reach the backend.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# Public website origin used in share messages (no trailing slash).
EXPO_PUBLIC_WEB_URL=https://surplustovalue.com

# Google Maps / Places key for map picker.
# Restrict this key in Google Cloud (Android package + SHA-1, Maps/Places APIs only).
# For EAS cloud builds, set the same name as an EAS secret / env var — do not commit the real key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
