{
  "expo": {
    "name": "Surplus",
    "slug": "surplus",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.surplus.surplus",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Surplus to access your photos for product listings and chat.",
          "cameraPermission": "Allow Surplus to use your camera for product listings and chat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Surplus to use your camera to photograph products and send photos in chat."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Surplus to use your location to show listings near you."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#16A34A",
          "defaultChannel": "messages"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e7616d3-29a0-4000-9c70-8e2d60ae3381"
      }
    },
    "owner": "jue17"
  }
}
